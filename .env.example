# Copy to .env.local and fill in. Placeholders only — never commit real keys.

# ─── Preview mode ────────────────────────────────────────────────────────────
# Run the whole app on sample data with no database, so the screens can be
# looked at before Supabase exists. Set to 1 to enable.
#
# It bypasses authentication, so it is deliberately impossible to enable on a
# deployed instance: it also requires a non-production build, and both
# `next build` and `next start` set NODE_ENV=production.
NEXT_PUBLIC_PREVIEW_MODE=0

# ─── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API. The anon key is public by design — every rule that
# matters is enforced by RLS and the SECURITY DEFINER functions in
# supabase/migrations/. Never put the service_role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_anon_key

# ─── The assistant (server only) ─────────────────────────────────────────────
# Google AI Studio: https://aistudio.google.com/apikey
# Without a key the Ask panel says it is not switched on, and nothing else in
# the app is affected. Never prefix this with NEXT_PUBLIC_: that would put the
# key in the JavaScript bundle, where anybody can read it.
GEMINI_API_KEY=your_key_here

# The model. Defaults to gemini-3.5-flash, which is deliberately not the newest.
#
# On a free key the newest Flash, 3.6, allows twenty requests A DAY, which is
# about five questions. 3.5 has a real allowance. Pro is unreachable on a free
# key entirely: it answers with a quota of exactly zero, and the assistant says
# so rather than telling anybody to wait.
#
# With billing enabled on the Google Cloud project, switch this up.
# GEMINI_MODEL=gemini-3.6-flash

# How much it thinks before answering: minimal, low or high on Gemini 3, or a
# plain number for a token budget on 2.5. Left unset on purpose, because unset
# means whatever the model does by default and is always valid.
# GEMINI_THINKING_LEVEL=

# For a proxy or a gateway. Defaults to Google.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ─── Google Sheets sync (optional, server only) ──────────────────────────────
# Not required to run the app — the sync worker is not built yet. v1 shipped
# without these documented, so a fresh clone could not get sync working at all.
GOOGLE_SERVICE_ACCOUNT_EMAIL=voucher-sheet-sync@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_key_here\n-----END PRIVATE KEY-----\n"

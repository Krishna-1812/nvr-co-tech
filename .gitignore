# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template. Without it a fresh clone has no record of which
# variables the app needs, and it holds placeholders only.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
sample-voucher.pdf
sample-export.xlsx

# Generated by scripts/make-sample-recon.tsx — sample ledgers and their exports.
/scratch

# Launch videos made by the /brag and /brag-slim skills (.claude/skills).
# Renders, their working frames and the composition node_modules are large
# and never belong in the repo.
brag-output*/
brag-reels*/
.indexnow-state.json
